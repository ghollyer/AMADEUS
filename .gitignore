# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment and local config
.env
.env.*
!.env.example
.claude/

# Build metadata
build/
dist/
*.egg-info/

# Runtime data and logs
logs/
*.log
amadeus_data/
data/
test-data/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Documentation and vendor material (case matters on Linux: the dir is Reference/)
reference/
Reference/
# Per-deployment config written by the setup wizard (contains IPs/paths)
amadeus_config.json

# The operator workspace ships its Claude Code settings (but not local overrides)
!operator/.claude/
operator/.claude/settings.local.json
